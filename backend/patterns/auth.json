  ],
  "common_stacks": [
    "Python (FastAPI) + PostgreSQL",
    "Node.js (Express/Fastify) + PostgreSQL",
    "Go (Gin/Fiber) + PostgreSQL"
  ],
  "known_constraints": {
    "security": [
      "OWASP_TOP_10",
      "bcrypt_rounds_12",
      "JWT_RS256_or_HS256",
      "httpOnly_SameSite_Strict"
    ],
    "access_token_expiry": "15m",
    "refresh_token_expiry": "30d",
    "typical_latency_ms": 50
  },
  "known_failure_modes": [
    "Storing JWT in browser localStorage (vulnerable to XSS) \u2014 use httpOnly SameSite=Strict cookies",
    "Not rotating refresh tokens on every refresh request \u2014 reuse detection prevents replay attacks",
    "Using weak password hashing algorithms or low bcrypt cost \u2014 use minimum 12 bcrypt rounds or Argon2id",
    "Missing rate limiting on /login and /forgot-password endpoints \u2014 risk of brute force attacks"
  ],
  "confidence_score": 0.98
}