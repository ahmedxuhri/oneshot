{
  "id": "iot_data_pipeline",
  "name": "IoT Telemetry & Device Ingestion Pipeline",
  "category": "iot",
  "description": "High-velocity sensor data streaming architecture with MQTT/HTTP device ingestion, anomaly detection rules, downsampling, and alert thresholds.",
  "keywords": [
    "iot",
    "telemetry",
    "sensors",
    "mqtt",
    "devices",
    "stream",
    "hardware",
    "readings",
    "timeseries",
    "firmware"
  ],
  "data_models": {
    "devices": {
      "table": "devices",
      "fields": [
        {
          "name": "id",
          "type": "UUID",
          "primary": true
        },
        {
          "name": "device_uuid",
          "type": "VARCHAR(100)",
          "unique": true,
          "nullable": false
        },
        {
          "name": "name",
          "type": "VARCHAR(255)"
        },
        {
          "name": "firmware_version",
          "type": "VARCHAR(50)"
        },
        {
          "name": "status",
          "type": "VARCHAR(30)",
          "default": "active"
        },
        {
          "name": "last_heartbeat_at",
          "type": "TIMESTAMP WITH TIME ZONE"
        }
      ],
      "indexes": [
        "device_uuid",
        "status"
      ],
      "proven_uses": 11000
    },
    "sensor_readings": {
      "table": "sensor_readings",
      "fields": [
        {
          "name": "device_id",
          "type": "UUID",
          "nullable": false
        },
        {
          "name": "metric",
          "type": "VARCHAR(50)",
          "nullable": false
        },
        {
          "name": "value",
          "type": "DOUBLE PRECISION",
          "nullable": false
        },
        {
          "name": "recorded_at",
          "type": "TIMESTAMP WITH TIME ZONE",
          "nullable": false
        }
      ],
      "indexes": [
        "device_id",
        "recorded_at",
        "metric"
      ],
      "proven_uses": 12000
    }
  },
  "clarifying_questions": [
    {
      "id": "ingestion_protocol",
      "question": "Device ingestion protocol?",
      "options": [
        "MQTT Broker (EMQX / Mosquitto)",
        "HTTPS REST Endpoint with API keys",
        "CoAP / WebSockets"
      ],
      "impacts": "Sets up MQTT worker bridge or HTTP ingestion handler"
    },
    {
      "id": "storage_retention",
      "question": "Telemetry downsampling & retention?",
      "options": [
        "Retain raw data for 30 days, then roll up into hourly averages",
        "Store all raw data indefinitely in TimescaleDB/InfluxDB",
        "S3 Cold Storage archive"
      ],
      "impacts": "Adds automated downsampling continuous aggregate policies"
    }
  ],
  "common_stacks": [
    "Python (FastAPI + Asyncio) + TimescaleDB / QuestDB",
    "Go + MQTT + InfluxDB"
  ],
  "known_constraints": {
    "ingestion_latency_ms": 10,
    "compression_ratio_target": "10:1"
  },
  "known_failure_modes": [
    "Connecting thousands of devices directly to a relational database instead of an MQTT broker buffer",
    "Lack of device clock synchronization causing out-of-order time-series inserts",
    "Missing heartbeat watchdog to detect dead devices"
  ],
  "confidence_score": 0.91
}