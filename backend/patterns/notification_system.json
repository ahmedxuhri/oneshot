        {
          "name": "provider_message_id",
          "type": "VARCHAR(255)"
        },
        {
          "name": "created_at",
          "type": "TIMESTAMP WITH TIME ZONE",
          "default": "NOW()"
        }
      ],
      "indexes": [
        "user_id",
