    },
    "notification_logs": {
      "table": "notification_logs",
      "fields": [
        {
          "name": "id",
          "type": "UUID",
          "primary": true
        },
        {
          "name": "user_id",
          "type": "UUID",
          "nullable": false
        },
        {
          "name": "template_slug",
          "type": "VARCHAR(100)",
          "nullable": false
