  "clarifying_questions": [
    {
      "id": "feed_architecture",
      "question": "Feed generation strategy?",
      "options": [
        "Fan-out on Read (Query followers on request)",
        "Fan-out on Write (Push to Redis timelines)",
        "Hybrid (Celebrity fan-out on read, standard fan-out on write)"
      ],
      "impacts": "Determines Redis timeline caching vs SQL JOIN feed querying"
    },
    {
      "id": "privacy_scope",
      "question": "Post privacy controls?",
      "options": [
        "Public only",
        "Public vs Followers only",
        "Granular (Close friends, Circles, Unlisted)"
      ],
      "impacts": "Adds privacy filters and access control index"
    }
  ],
  "common_stacks": [
    "Python (FastAPI) + PostgreSQL + Redis",
    "Node.js + PostgreSQL + Redis streams",
    "Go + ScyllaDB + Redis"
  ],
  "known_constraints": {
    "feed_latency_target_ms": 100,
    "max_post_media_items": 10
  },
  "known_failure_modes": [
